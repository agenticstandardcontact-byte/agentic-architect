{
  "routes": [
    {
      "route": "/404.html",
      "statusCode": 404
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/assets/*",
      "/*.{css,js,svg,png,jpg,jpeg,gif,webp,ico,xml,txt,md,mdc,zip,html,woff,woff2}"
    ]
  },
  "mimeTypes": {
    ".xml": "application/xml",
    ".md": "text/markdown",
    ".mdc": "text/plain",
    ".zip": "application/zip"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}
